rules_version = '2';

// Student-app data: SERVER ONLY. The app has no direct Firestore access; every read and write goes through the
// backend (backend/netlify → the handlers in functions/, Admin SDK, which bypasses rules). So the student app does
// not depend on these rules or on the question bank editor's rules in the shared database (primary-math-sg
// "default"), and nothing here needs to be merged into the editor's rules except the editor's own report access
// (firestore.editor-reports.rules, merged by scripts/deploy-rules.mjs).
//
// Student collections: users/{uid} (+ progress, wrong, ledger, attempts, starredLevels, attempted, minigames,
// reportQuota), wallets, publicProfiles, friendCodes, referrals, friendships, friendRequests, leaderboards,
// leaderboardSnapshots, leaderboardMeta, medals, entitlements, question_reports.
// Classroom (packages/shared/src/classroom.ts): teachers, classes (+ posts, tasks, tasks/{id}/marks) and users/{uid}/qstats,
// levelStars, attempted are server only too: the catch-all below denies every client, signed in or not, so nothing
// more is needed here. Same for admins/{uid} and adminLog/{id} (owner dashboard, packages/shared/src/admin.ts): no client
// ever reads or writes them, admins are created only by backend/scripts/add-admin.mjs (Admin SDK / REST with the setup account).
// (backend/scripts/deploy-rules.mjs keeps deploying this one file to both projects unchanged.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
