{
  "name": "p6-math-game-functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.mjs",
    "prebuild": "npm run copy-shared",
    "build": "tsc",
    "typecheck": "npm run copy-shared && tsc --noEmit",
    "pretest": "npm run copy-shared",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
